DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-secret-change-me"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
WEB_ORIGIN="http://localhost:5173"

# SMTP — required in production (email verification + password reset).
# Leave unset in dev to fall back to console-logged emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="SpotifAI <no-reply@spotifai.local>"
