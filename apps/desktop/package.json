{
  "name": "@spotifai/desktop",
  "version": "0.1.0",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "nano:corpus": "python3 nano/corpus/build_corpus.py",
    "nano:verify": "python3 nano/corpus/verify_blurbs.py",
    "nano:train": "python3 ../../../Project-K/tools/train_simple_gla.py --dataset spotifai_music --meta nano/corpus/spotifai_music_meta.pkl --output /tmp/spotifai_music.pt",
    "nano:export": "python3 ../../../Project-K/tools/export_int4_bin.py --ckpt /tmp/spotifai_music.pt --output nano/track-describer.bin"
  },
  "devDependencies": {
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.spotifai.desktop",
    "productName": "SpotifAI",
    "files": ["src/**/*"],
    "directories": { "output": "dist" },
    "mac": { "icon": "build/icon.png" },
    "win": { "icon": "build/icon.ico" },
    "linux": { "icon": "build/icon.png" }
  }
}
