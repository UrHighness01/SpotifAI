node_modules/
dist/
build/
apps/desktop/dist/
.electron-cache/
.electron-builder-cache/
.env
.env.*
!.env.example
storage/audio/*
storage/covers/*
storage/avatars/*
storage/banners/*
!storage/audio/.gitkeep
!storage/covers/.gitkeep
!storage/avatars/.gitkeep
!storage/banners/.gitkeep

# personal local test files — never commit real audio
*.mp3
*.log
.DS_Store
apps/api/prisma/dev.db

# nano corpus derived artifacts — regenerable via `npm run nano:corpus`
apps/desktop/nano/corpus/*.bin
apps/desktop/nano/corpus/*.pkl
apps/desktop/nano/*.bin

# nano engine build artifacts (regenerable via gcc) + derived vocab
apps/desktop/nano/engine/track_describer
apps/desktop/nano/engine/vocab.tsv

# generator-signature corpus — collected data, not source
apps/prisma/corpus/*.jsonl
# ...but the gate-passing SNAPSHOT + hash record ARE committed (auditability —
# the corpus that underwrites signature-matched must be reproducibly pinned)
!apps/prisma/corpus/snapshots/*.jsonl
!apps/prisma/corpus/snapshots/README.txt
apps/api/prisma/dev.db-journal
# local loop-graph scratch docs — kept in the folder, never committed
build-loop.html
build-loop-nano.html
.claude/
*.tsbuildinfo
